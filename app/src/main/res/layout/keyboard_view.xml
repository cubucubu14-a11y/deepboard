<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1F22"
    android:padding="4dp">

    <!-- LAYER 1: HOME (SHORTCUT) -->
    <LinearLayout
        android:id="@+id/layerShortcut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/btnSelAll" android:text="SEL ALL" android:textSize="10sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnCopy" android:text="COPY" android:textSize="10sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnPaste" android:text="PASTE" android:textSize="10sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnFind" android:text="FIND" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#8a2be2" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/btnSelect" android:text="SELECT" android:textSize="10sp" android:textColor="#AAAAAA" android:background="@drawable/bg_btn_primary" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnLeft" android:text="←" android:textSize="20sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnDown" android:text="↓" android:textSize="20sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnUp" android:text="↑" android:textSize="20sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnRight" android:text="→" android:textSize="20sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnDel" android:text="DEL" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#B71C1C" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="46dp" android:layout_margin="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnUndo" android:text="UNDO" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#D32F2F" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnRedo" android:text="REDO" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#388E3C" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnTab" android:text="TAB" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#1976D2" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnEnter" android:text="ENTER" android:textSize="10sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnToAlpha" android:text="ABC / QWERTY" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#007BFF" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1.5" android:layout_height="46dp" android:layout_margin="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- LAYER 2: HURUF (SPASI KIRI, TANPA ENTER) -->
    <LinearLayout
        android:id="@+id/layerAlpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/btnQ" android:text="q" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnW" android:text="w" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnE" android:text="e" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnR" android:text="r" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnT" android:text="t" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnY" android:text="y" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnU" android:text="u" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnI" android:text="i" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnO" android:text="o" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnP" android:text="p" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp" android:paddingLeft="8dp" android:paddingRight="8dp">
            <Button android:id="@+id/btnA" android:text="a" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnS" android:text="s" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnD" android:text="d" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnF" android:text="f" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnG" android:text="g" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnH" android:text="h" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnJ" android:text="j" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnK" android:text="k" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnL" android:text="l" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnDelLetter" android:text="DEL" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#B71C1C" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="46dp" android:layout_margin="2dp"/>
        </LinearLayout>

        <!-- Baris Bawah: Spasi Kiri, Shortcut Kanan -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnToSymbol" android:text="123" android:textSize="12sp" android:textColor="#FFFFFF" android:background="@drawable/bg_btn_primary" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnZ" android:text="z" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnX" android:text="x" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            
            <!-- SPASI DI SINI -->
            <Button android:id="@+id/btnSpasi" android:text="SPASI" android:textSize="11sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="2.5" android:layout_height="46dp" android:layout_margin="2dp"/>
            
            <Button android:id="@+id/btnC" android:text="c" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnV" android:text="v" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnB" android:text="b" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnN" android:text="n" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnM" android:text="m" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnKoma" android:text="," android:textSize="14sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_primary" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnTitik" android:text="." android:textSize="14sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_primary" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnToShortcut" android:text="SHORTCUT" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#007BFF" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="46dp" android:layout_margin="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- LAYER 3: SIMBOL -->
    <LinearLayout
        android:id="@+id/layerSymbol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/btn1" android:text="1" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btn2" android:text="2" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btn3" android:text="3" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btn4" android:text="4" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btn5" android:text="5" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btn6" android:text="6" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btn7" android:text="7" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btn8" android:text="8" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btn9" android:text="9" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btn0" android:text="0" android:textSize="16sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/btnBukaKurawal" android:text="{" android:textSize="14sp" android:textColor="#64B5F6" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnTutupKurawal" android:text="}" android:textSize="14sp" android:textColor="#64B5F6" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnBukaKurung" android:text="(" android:textSize="14sp" android:textColor="#64B5F6" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnTutupKurung" android:text=")" android:textSize="14sp" android:textColor="#64B5F6" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnBukaSiku" android:text="[" android:textSize="14sp" android:textColor="#64B5F6" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnTutupSiku" android:text="]" android:textSize="14sp" android:textColor="#64B5F6" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnKurang" android:text="&lt;" android:textSize="14sp" android:textColor="#64B5F6" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnLebih" android:text="&gt;" android:textSize="14sp" android:textColor="#64B5F6" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnSamaDengan" android:text="=" android:textSize="14sp" android:textColor="#64B5F6" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnTambah" android:text="+" android:textSize="14sp" android:textColor="#64B5F6" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnToAlpha" android:text="ABC" android:textSize="12sp" android:textColor="#FFFFFF" android:backgroundTint="#007BFF" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnStrip" android:text="_" android:textSize="14sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnPetik2" android:text="&quot;" android:textSize="14sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnPetik1" android:text="'" android:textSize="14sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnTitikKoma" android:text=";" android:textSize="14sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnTitikDua" android:text=":" android:textSize="14sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnSpasiSymbol" android:text="SPASI" android:textSize="11sp" android:textColor="#E3E3E3" android:background="@drawable/bg_btn_dark" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="2" android:layout_height="46dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnToShortcutSymbol" android:text="SHORTCUT" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#007BFF" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="46dp" android:layout_margin="2dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

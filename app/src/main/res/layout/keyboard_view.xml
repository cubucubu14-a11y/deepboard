<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:padding="4dp">

    <!-- LAYER 1: SHORTCUT -->
    <LinearLayout
        android:id="@+id/layerShortcut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/btnSelAll" android:text="SEL ALL" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnCopy" android:text="COPY" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnPaste" android:text="PASTE" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnFind" android:text="FIND" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#8a2be2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_margin="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/btnSelect" android:text="SELECT" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="45dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnLeft" android:text="←" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnDown" android:text="↓" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnUp" android:text="↑" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnRight" android:text="→" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnDel" android:text="DEL" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#b71c1c" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="45dp" android:layout_margin="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnUndo" android:text="UNDO" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#d32f2f" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnRedo" android:text="REDO" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#388e3c" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnTab" android:text="TAB" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#1976d2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnEnter" android:text="ENTER" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_margin="2dp"/>
            <Button android:id="@+id/btnToAlpha" android:text="ABC / 123" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#007BFF" android:layout_width="0dp" android:layout_weight="1.5" android:layout_height="45dp" android:layout_margin="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- LAYER 2: HURUF & ANGKA -->
    <LinearLayout
        android:id="@+id/layerAlpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="2dp">
            <Button android:id="@+id/btn1" android:text="1" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btn2" android:text="2" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btn3" android:text="3" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btn4" android:text="4" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btn5" android:text="5" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btn6" android:text="6" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btn7" android:text="7" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btn8" android:text="8" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btn9" android:text="9" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btn0" android:text="0" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/btnBukaKurawal" android:text="{" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnTutupKurawal" android:text="}" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnBukaKurung" android:text="(" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnTutupKurung" android:text=")" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnBukaSiku" android:text="[" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnTutupSiku" android:text="]" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnKurang" android:text="&lt;" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnLebih" android:text="&gt;" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnSamaDengan" android:text="=" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnTambah" android:text="+" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:layout_margin="1dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="2dp">
            <Button android:id="@+id/btnQ" android:text="q" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnW" android:text="w" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnE" android:text="e" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnR" android:text="r" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnT" android:text="t" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnY" android:text="y" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnU" android:text="u" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnI" android:text="i" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnO" android:text="o" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnP" android:text="p" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="2dp" android:paddingLeft="10dp" android:paddingRight="10dp">
            <Button android:id="@+id/btnA" android:text="a" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnS" android:text="s" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnD" android:text="d" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnF" android:text="f" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnG" android:text="g" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnH" android:text="h" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnJ" android:text="j" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnK" android:text="k" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnL" android:text="l" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnZ" android:text="z" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnX" android:text="x" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnC" android:text="c" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnV" android:text="v" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnB" android:text="b" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnN" android:text="n" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnM" android:text="m" android:textSize="18sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnSpasi" android:text="SPASI" android:textSize="12sp" android:layout_width="0dp" android:layout_weight="3" android:layout_height="48dp" android:layout_margin="1dp"/>
            <Button android:id="@+id/btnToShortcut" android:text="SHORTCUT" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#007BFF" android:layout_width="0dp" android:layout_weight="1.5" android:layout_height="48dp" android:layout_margin="1dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

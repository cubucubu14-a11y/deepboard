<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#2B2D30"
    android:padding="20dp"
    android:elevation="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pengaturan DeepBoard"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"/>

    <!-- Pengaturan Tinggi -->
    <TextView
        android:id="@+id/tvHeightLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tinggi Tombol: 46dp"
        android:textColor="#AAAAAA"
        android:textSize="14sp"/>
    <SeekBar
        android:id="@+id/seekHeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:progressTint="#007BFF"/>

    <!-- Pengaturan Font -->
    <TextView
        android:id="@+id/tvFontLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ukuran Huruf: 16sp"
        android:textColor="#AAAAAA"
        android:textSize="14sp"/>
    <SeekBar
        android:id="@+id/seekFont"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:progressTint="#007BFF"/>

    <!-- TOMBOL TUTUP YANG HILANG TADI -->
    <Button
        android:id="@+id/btnClosePopup"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="TUTUP"
        android:textColor="#FFFFFF"
        android:backgroundTint="#B71C1C"/>

</LinearLayout>
